# Copy this file to .env.local and fill in the value.
# .env.local is git-ignored. It is used by both `npm run dev` and `npm run build`.
#
# Base URL of the spot price API (API Gateway HTTP API), without a trailing slash.
# Note: this value ends up in the built JavaScript and is public. Never put secrets here.
VITE_API_URL=https://<api-id>.execute-api.eu-north-1.amazonaws.com
