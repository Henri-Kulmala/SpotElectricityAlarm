# Apache / LiteSpeed config for the static build on cPanel.
# Vite copies this file from public/ into dist/ as-is.
# Every block is wrapped in <IfModule>, so a missing module never causes a 500 error.

DirectoryIndex index.html
Options -Indexes

# --- Force HTTPS -------------------------------------------------------------
# Remove this block if the host already redirects to HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Caching -----------------------------------------------------------------
# Built JS/CSS/fonts have a content hash in their name (index-fQbJ3RoR.js),
# so they can be cached "forever". index.html must always be revalidated,
# otherwise visitors keep getting an old page that points to old files.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|ico|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # --- Basic security headers ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- MIME types --------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>
